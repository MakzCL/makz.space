SYNDO_DOMAIN=chat.example.com
SYNDO_MEDIA_DOMAIN=media.example.com
POSTGRES_PASSWORD=change-me-long-random
# Generate: openssl rand -hex 16  /  openssl rand -base64 32
LIVEKIT_API_KEY=APIchangeme
LIVEKIT_API_SECRET=change-me-at-least-32-characters-long
# smtp(s)://user:pass@smtp.example.com:465 — without it, emails are only recorded in the database
SMTP_URL=
SYNDO_MAIL_FROM=Syndo <no-reply@example.com>
SYNDO_MAX_UPLOAD_MB=100
