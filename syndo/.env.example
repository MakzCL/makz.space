# Local development (see DEPLOYMENT.md for production).
DATABASE_URL=postgres://syndo:syndo@localhost:5432/syndo
SYNDO_PUBLIC_URL=http://localhost:5173
SYNDO_DEV_MAIL=1            # exposes /api/dev/mail (the email outbox) — never in production
# LiveKit dev server: `livekit-server --dev` uses key "devkey" / secret "secret"
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
