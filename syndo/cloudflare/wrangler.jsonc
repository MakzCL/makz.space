{
  "name":"send-beta-api",
  "main":"worker.ts",
  "compatibility_date":"2026-11-03",
  "compatibility_flags":["nodejs_compat"],
  "observability":{"enabled":true,"head_sampling_rate":1},
  "containers":[{"name":"send-beta-api","class_name":"SENDBackend","scheduling_policy":"durable_object"}],
  "durable_objects":{"bindings":[{"name":"BACKEND","class_name":"SENDBackend"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["SENDBackend"]}],
  "r2_buckets":[{"binding":"UPLOADS","bucket_name":"syndo-beta-uploads"}],
  "vars":{"SOURCE_COMMIT":"0e29efa1e5c9a709598344a6b64655709785ea80","STORAGE_ORIGIN":"https://send-beta-api.kuklinskikarol04.workers.dev"}
}
