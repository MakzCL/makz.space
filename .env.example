# =========================================================================
# MAKZ — environment
# Copy to .env.local and fill in. Nothing here is optional for the account
# layer; everything else on the site runs without it.
# =========================================================================

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
# Dashboard → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable ("anon") key. Safe in the browser: every table is
# protected by row level security, so this key can only ever do what the
# signed-in account is allowed to do.
# Dashboard → Project Settings → API Keys → anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute origin of this deployment. Used for canonical URLs, Open Graph
# and — importantly — the redirect target in confirmation and password
# reset emails. Set it in production; locally it falls back to the request
# host, which is correct for http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://makz.space

# The service role key is deliberately absent. No part of this codebase
# uses it, and it must never be added to a Next.js environment that ships
# any client bundle.
